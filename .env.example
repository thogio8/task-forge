# App
HTTP_PORT=8080

# Database
DB_HOST=db
DB_PORT=5432
DB_USER=taskforge
DB_PASSWORD=changeme
DB_NAME=taskforge
DB_SSL_MODE=disable

# Log
LOG_LEVEL=info   # "debug", "info", "warn", "error"
LOG_FORMAT=json  # "json", "text"

# Worker
WORKER_POOL_SIZE=5
WORKER_POLL_INTERVAL=30s
WORKER_BATCH_SIZE=10
WORKER_TASK_TIMEOUT=30s
WORKER_STALE_INTERVAL=30s
WORKER_STALE_DURATION=5m

# Instance
INSTANCE_MONITOR_INTERVAL=30s
HEARTBEAT_TIMEOUT=15s
HEARTBEAT_INTERVAL=5s
LEADER_INTERVAL=10s

# Shutdown
SHUTDOWN_TIMEOUT=30s

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=tasks
KAFKA_GROUP_ID=taskforge-workers

# Outbox
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=50
OUTBOX_RETENTION=24h

# OpenTelemetry
OTEL_COLLECTOR_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=taskforge
OTEL_EXPORT_INTERVAL=15s