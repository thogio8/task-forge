{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["taskforge", "http"],
  "title": "TaskForge — HTTP Overview",
  "uid": "taskforge-http",
  "version": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request Rate (req/s)",
      "description": "HTTP requests per second broken down by method, route and status code",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(taskforge_http_server_request_count_total[1m])",
          "legendFormat": "{{http_method}} {{http_route}} ({{http_status_code}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency P50 / P95 / P99",
      "description": "Request duration percentiles per route",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(taskforge_http_server_request_duration_seconds_bucket[5m])) by (le, http_route))",
          "legendFormat": "P50 {{http_route}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(taskforge_http_server_request_duration_seconds_bucket[5m])) by (le, http_route))",
          "legendFormat": "P95 {{http_route}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(taskforge_http_server_request_duration_seconds_bucket[5m])) by (le, http_route))",
          "legendFormat": "P99 {{http_route}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error Rate (4xx / 5xx)",
      "description": "HTTP error rate by status code",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(taskforge_http_server_request_count_total{http_status_code=~\"4..\"}[1m])",
          "legendFormat": "4xx {{http_route}} ({{http_status_code}})",
          "refId": "A"
        },
        {
          "expr": "rate(taskforge_http_server_request_count_total{http_status_code=~\"5..\"}[1m])",
          "legendFormat": "5xx {{http_route}} ({{http_status_code}})",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active Requests",
      "description": "Current number of in-flight HTTP requests",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(taskforge_http_server_active_requests)",
          "legendFormat": "active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total Requests (15m)",
      "description": "Total HTTP requests in the last 15 minutes",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(taskforge_http_server_request_count_total[15m]))",
          "legendFormat": "total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      }
    }
  ]
}
